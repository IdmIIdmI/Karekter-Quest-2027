
<!DOCTYPE html>
<html lang="ms">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>KARAKTER QUEST 2027</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#102d2a;color:#fff}
header{background:#174b40;padding:25px 16px;text-align:center}
header h1{font-size:27px;margin:5px}
header p{color:#d5eee0}
main{max-width:700px;margin:auto;padding:16px}
.panel{background:#fff;color:#203b35;border-radius:18px;padding:20px;margin:14px 0}
h2{margin-top:0;color:#175b48}
button{width:100%;border:0;border-radius:12px;padding:15px;margin:7px 0;background:#176b50;color:white;font-size:16px;font-weight:bold}
button:hover{opacity:.9}
.choice{background:#e9f3ec;color:#174b40;text-align:left;border:2px solid #c6dfcf}
.choice:active{background:#b9e2c4}
.stat{display:flex;justify-content:space-around;text-align:center;gap:8px}
.stat div{background:#e8f3ed;border-radius:12px;padding:12px;flex:1}
.stat strong{display:block;font-size:23px;color:#176b50}
.small{font-size:13px;color:#60746c}
#story{line-height:1.7;font-size:17px}
#feedback{padding:12px;background:#e9f3ec;border-radius:10px;margin-top:12px;line-height:1.6}
footer{text-align:center;padding:20px;color:#b8d5c9;font-size:12px}
</style>
</head>
<body>
<header>
<div>🌿 🏞️ 🌺</div>
<h1>KARAKTER QUEST 2027</h1>
<p>Pengembaraan Membina Insan Berkarakter</p>
<p><b>365 Hari • 4 Teras Karakter • 1 Misi Kehidupan</b></p>
</header>
<main>
<section class="panel">
<h2>Selamat datang, Pengembara!</h2>
<p>Di bumi Sarawak, setiap tindakan membawa makna. Bukan siapa paling hebat, tetapi siapa yang memilih untuk melakukan kebaikan.</p>
<div class="stat">
<div><strong id="points">0</strong><span class="small">Bintang</span></div>
<div><strong id="done">0</strong><span class="small">Misi selesai</span></div>
<div><strong id="level">1</strong><span class="small">Tahap</span></div>
</div>
</section>

<section class="panel" id="game">
<h2>🧭 Pilih pengembaraan</h2>
<p>Empat cabaran menanti kamu. Setiap pilihan menunjukkan karakter diri.</p>
<div id="missions"></div>
</section>

<section class="panel" id="play" hidden>
<p class="small" id="world"></p>
<h2 id="missionTitle"></h2>
<div id="story"></div>
<div id="choices"></div>
<div id="feedback" hidden></div>
<button id="next" hidden onclick="nextMission()">Kembali ke peta misi</button>
</section>

<section class="panel">
<h2>🌟 Empat Teras Karakter</h2>
<p>💚 <b>Penyayang</b> — mengambil berat terhadap orang lain.</p>
<p>🛡️ <b>Berdaya Tahan</b> — tidak mudah menyerah.</p>
<p>👑 <b>Berupaya Memimpin</b> — memimpin dengan adil.</p>
<p>🌏 <b>Warganegara Aktif</b> — menjaga masyarakat dan alam.</p>
</section>
</main>
<footer>KARAKTER QUEST 2027 • Belajar melalui pengalaman</footer>

<script>
const missions=[
{
world:"DUNIA 1 • KAMPUNG SARAWAK",
title:"Bakul Aki",
story:"Dalam perjalanan pulang dari sekolah, kamu terlihat Aki membawa bakul yang berat. Buah-buahan hampir terjatuh. Kawan kamu mengajak bermain. Apakah tindakan kamu?",
choices:[
["Membantu Aki membawa bakul.", "Hebat! Kamu memilih untuk membantu. Aki tersenyum dan berasa dihargai.",10],
["Terus bermain dan membiarkan Aki.", "Aki terpaksa mengangkat bakul seorang diri. Kamu terlepas peluang membantu.",0],
["Memanggil kawan lain untuk membantu bersama.", "Bagus! Kamu mengajak orang lain melakukan kebaikan bersama.",15]
]},
{
world:"DUNIA 2 • KETUA YANG ADIL",
title:"Ketua Kumpulan",
story:"Cikgu meminta kamu mengetuai kumpulan. Dua orang kawan mahu menjadi ketua kecil. Mereka mula bertengkar. Apakah tindakan kamu?",
choices:[
["Memilih kawan yang paling rapat.", "Kawan lain berasa tersisih. Seorang pemimpin perlu berlaku adil.",0],
["Mendengar pandangan kedua-duanya dan membahagikan tugas.", "Bijak! Kamu mendengar dan memberi peluang kepada semua.",15],
["Marah mereka supaya diam.", "Mereka diam, tetapi masalah belum diselesaikan.",0]
]},
{
world:"DUNIA 3 • MENARA YANG RUNTUH",
title:"Jangan Mudah Menyerah",
story:"Kumpulan kamu membina menara daripada batang aiskrim. Tiba-tiba menara itu runtuh. Ada kawan yang mahu berhenti. Apa yang kamu lakukan?",
choices:[
["Mencuba semula dengan cara yang lebih baik.", "Hebat! Kegagalan menjadi peluang untuk belajar.",15],
["Menyalahkan kawan yang membina.", "Kawan kamu sedih. Menyalahkan orang tidak membina semangat.",0],
["Berhenti kerana sudah gagal.", "Kamu belum memberi peluang kepada diri untuk mencuba lagi.",0]
]},
{
world:"DUNIA 4 • SUNGAI KITA",
title:"Sungai Bersih, Kampung Ceria",
story:"Kamu melihat sampah plastik berhampiran sungai kampung. Beberapa orang sedang bermain di situ. Apakah tindakan kamu?",
choices:[
["Membuang sampah ke dalam sungai.", "Sungai menjadi lebih kotor. Alam perlu dijaga.",0],
["Mengutip sampah dengan selamat dan mengajak kawan menjaga kebersihan.", "Tahniah! Kamu menjaga alam dan mengajak masyarakat melakukan kebaikan.",15],
["Membiarkan sahaja kerana bukan sampah kamu.", "Sungai milik bersama. Menjaganya tanggungjawab bersama.",0]
]}
];

let points=Number(localStorage.getItem("cq_points")||0);
let completed=JSON.parse(localStorage.getItem("cq_done")||"[]");
let current=0;

function update(){
document.getElementById("points").textContent=points;
document.getElementById("done").textContent=completed.length;
document.getElementById("level").textContent=Math.floor(points/30)+1;
localStorage.setItem("cq_points",points);
localStorage.setItem("cq_done",JSON.stringify(completed));
}

function showMissions(){
document.getElementById("game").hidden=false;
document.getElementById("play").hidden=true;
let html="";
missions.forEach((m,i)=>{
let done=completed.includes(i);
html+=`<button ${done?"disabled":""} onclick="startMission(${i})">${done?"✅ ":"🌟 "} ${m.title} ${done?"(Selesai)":"— Mula misi"}</button>`;
});
document.getElementById("missions").innerHTML=html;
update();
}
function startMission(i){
current=i;
let m=missions[i];
document.getElementById("game").hidden=true;
document.getElementById("play").hidden=false;
document.getElementById("world").textContent=m.world;
document.getElementById("missionTitle").textContent=m.title;
document.getElementById("story").textContent=m.story;
document.getElementById("feedback").hidden=true;
document.getElementById("next").hidden=true;
let html="";
m.choices.forEach((c,j)=>{
html+=`<button class="choice" onclick="choose(${j})">${c[0]}</button>`;
});
document.getElementById("choices").innerHTML=html;
}
function choose(j){
let m=missions[current];
let c=m.choices[j];
document.getElementById("choices").innerHTML="";
document.getElementById("feedback").hidden=false;
document.getElementById("feedback").innerHTML="<b>Akibat pilihan kamu:</b><br>"+c[1]+"<br><br><b>+"+c[2]+" bintang</b>";
if(!completed.includes(current)){
points+=c[2];
completed.push(current);
}
update();
document.getElementById("next").hidden=false;
}
function nextMission(){showMissions()}
showMissions();
</script>
</body>
</html>
