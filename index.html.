
<!DOCTYPE html>
<html lang="ms">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Karakter Quest 2027</title>
<style>
body{
 margin:0;padding:20px;
 font-family:Arial,sans-serif;
 background:linear-gradient(135deg,#123c35,#187b64);
 color:#fff;text-align:center;
}
.card{
 background:white;color:#173b32;
 max-width:480px;margin:30px auto;
 padding:25px;border-radius:22px;
 box-shadow:0 8px 25px #0004;
}
h1{color:#ffe29a;font-size:30px}
h2{font-size:23px}
p{font-size:18px;line-height:1.6}
button{
 width:100%;padding:16px;margin:8px 0;
 border:0;border-radius:12px;
 background:#eab83c;color:#173b32;
 font-size:17px;font-weight:bold;
}
.choice{background:#e5f1eb}
#game,#finish{display:none}
#feedback{
 background:#e8f5ec;padding:15px;
 border-radius:12px;color:#173b32;
 margin-top:15px;
}
</style>
</head>
<body>

<h1>🌿 KARAKTER QUEST 2027</h1>
<p>Misi Membina Insan Hebat</p>

<div class="card" id="home">
<h2>🏆 Selamat Datang, Wira!</h2>
<p>Beranikah kamu membuat pilihan yang betul?</p>
<p>Selesaikan 5 misi dan buktikan karakter hebat kamu!</p>
<button onclick="mula()">🚀 MULAKAN MISI</button>
</div>

<div class="card" id="game">
<h2 id="tajuk"></h2>
<p id="cerita"></p>
<div id="pilihan"></div>
<div id="feedback" style="display:none"></div>
<button id="seterusnya" style="display:none" onclick="next()">MISI SETERUSNYA ➜</button>
</div>

<div class="card" id="finish">
<h2>🏆 TAHNIAH!</h2>
<p>Kamu telah menyelesaikan semua misi!</p>
<h1 id="markah" style="color:#17665c"></h1>
<p id="tahap"></p>
<button onclick="mula()">MAIN SEMULA</button>
</div>

<script>
const data=[
{
t:"🍱 MISI 1: AMANAH",
c:"Kamu jumpa dompet di kantin sekolah. Apa tindakan kamu?",
p:[
["Simpan duit itu",0,"Bukan amanah mengambil hak orang."],
["Serahkan kepada guru",10,"Bagus! Kamu seorang yang amanah."],
["Biarkan sahaja",3,"Kamu boleh membantu mencari pemiliknya."]
]},
{
t:"🤝 MISI 2: KERJASAMA",
c:"Rakan kamu tidak pandai menyiapkan tugasan. Apa tindakan kamu?",
p:[
["Biarkan dia",0,"Kita perlu saling membantu."],
["Bantu dan ajar dia",10,"Hebat! Itulah semangat kerjasama."],
["Marah kepadanya",0,"Kita perlu bersabar dengan rakan."]
]},
{
t:"🌳 MISI 3: CINTA ALAM",
c:"Kamu nampak sampah di tepi sungai kampung. Apa tindakan kamu?",
p:[
["Buang sampah ke sungai",0,"Sungai mesti dijaga."],
["Kutip dan buang dengan betul",10,"Syabas! Kamu menjaga alam sekitar."],
["Tinggalkan sahaja",2,"Kebersihan tanggungjawab bersama."]
]},
{
t:"❤️ MISI 4: PRIHATIN",
c:"Seorang rakan terjatuh ketika bermain. Apa tindakan kamu?",
p:[
["Ketawakan dia",0,"Jangan menyakiti hati orang."],
["Bantu dia bangun",10,"Bagus! Kamu prihatin."],
["Berlari meninggalkannya",0,"Rakan memerlukan bantuan kita."]
]},
{
t:"⭐ MISI 5: JUJUR",
c:"Kamu terpecahkan barang sekolah. Guru bertanya siapa yang melakukannya.",
p:[
["Mengaku dengan jujur",10,"Tahniah! Kejujuran memerlukan keberanian."],
["Salahkan rakan",0,"Jangan menipu atau menyalahkan orang."],
["Diam sahaja",2,"Berani mengaku kesalahan ialah sikap mulia."]
]}
];

let nombor=0,skor=0,selesai=false;

function mula(){
 nombor=0;skor=0;
 document.getElementById("home").style.display="none";
 document.getElementById("finish").style.display="none";
 document.getElementById("game").style.display="block";
 papar();
}

function papar(){
 selesai=false;
 let m=data[nombor];
 document.getElementById("tajuk").textContent=m.t;
 document.getElementById("cerita").textContent=m.c;
 document.getElementById("feedback").style.display="none";
 document.getElementById("seterusnya").style.display="none";
 let tempat=document.getElementById("pilihan");
 tempat.innerHTML="";
 m.p.forEach((pilihan,i)=>{
  let b=document.createElement("button");
  b.className="choice";
  b.textContent=String.fromCharCode(65+i)+". "+pilihan[0];
  b.onclick=()=>jawab(i);
  tempat.appendChild(b);
 });
}

function jawab(i){
 if(selesai)return;
 selesai=true;
 let m=data[nombor],p=m.p[i];
 skor+=p[1];
 document.getElementById("feedback").textContent=
 p[2]+" Markah: "+p[1]+"/10";
 document.getElementById("feedback").style.display="block";
 document.getElementById("seterusnya").style.display="block";
 document.querySelectorAll(".choice").forEach(b=>b.disabled=true);
}

function next(){
 nombor++;
 if(nombor<data.length){
  papar();
 }else{
  document.getElementById("game").style.display="none";
  document.getElementById("finish").style.display="block";
  document.getElementById("markah").textContent=skor+"/50";
  document.getElementById("tahap").textContent=
  skor>=40?"WIRA KARAKTER HEBAT! 🏆":
  skor>=25?"WIRA SEDANG BERKEMBANG! 🌟":
  "BAKAL WIRA! TERUS BELAJAR! 🌱";
 }
}
</script>
</body>
</html>
